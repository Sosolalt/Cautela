# Controls what `gcloud builds submit` (and `gcloud run deploy --source`)
# uploads as the build context. Without this, the multi-GB monorepo
# (datasets, .venv, node_modules) would be uploaded to Cloud Build.
#
# Used for the Cautela frontend build (ma_gatekeeper/frontend/cloudbuild.yaml),
# whose context is the repo root because the frontend imports
# <root>/design/tokens.ts. Allowlist style: ignore everything, then re-include
# only the frontend app sources and the design token source it needs.
#
# NOTE: presence of .gcloudignore disables gcloud's default use of .gitignore,
# so the rules below are the complete picture.

# 1) Ignore everything by default.
*

# 2) Re-include the frontend app (minus build output / deps / secrets).
!ma_gatekeeper/
ma_gatekeeper/*
!ma_gatekeeper/frontend/
ma_gatekeeper/frontend/node_modules/
ma_gatekeeper/frontend/.next/
ma_gatekeeper/frontend/.env
ma_gatekeeper/frontend/.env.local
!ma_gatekeeper/frontend/.env.example

# 3) Re-include the design token source imported at build time.
!design/

# 4) Belt-and-suspenders: never upload VCS / secrets / OS cruft.
.git/
**/.env
**/.env.local
**/.DS_Store
**/*.log
