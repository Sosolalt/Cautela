# Copy to `.env` and fill in. Cloud Run pulls these from Secret Manager.

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# In dev: gcloud auth application-default login
# On Cloud Run: default SA needs roles/aiplatform.user + roles/secretmanager.secretAccessor

# --- Arize Phoenix (self-hosted on Cloud Run) ---
# For self-hosted, both PHOENIX_API_KEY and PHOENIX_COLLECTOR_ENDPOINT point to your own instance.
PHOENIX_COLLECTOR_ENDPOINT=https://phoenix.your-domain.com
PHOENIX_API_KEY=px_live_
PHOENIX_PROJECT=ma-gatekeeper

# --- Phoenix MCP (used by the Reflector) ---
PHOENIX_MCP_BASE_URL=https://phoenix.your-domain.com
PHOENIX_MCP_API_KEY=

# --- Demo passcode (prevents random crawlers; surfaced in Devpost description) ---
DEMO_PASSCODE=

# --- Calibration artifact ---
THRESHOLDS_JSON=thresholds.json

# --- SEC EDGAR (contact required by SEC per fair-use rules) ---
SEC_EDGAR_USER_AGENT=hugo.majerczyk@proton.me
