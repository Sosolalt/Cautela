# Copy to `.env` and fill in. Cloud Run pulls these from Secret Manager.
#
# Sections below are split between REQUIRED-on-Cloud-Run (security or
# functionality breaks without them) and OPTIONAL (safe defaults).
# `tests/test_env_documented.py` asserts every `os.environ.get(KEY)`
# call in `agent/` has a corresponding key in this file.

# ============================================================
# REQUIRED for any non-localhost (Cloud Run) deploy
# ============================================================

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# In dev: gcloud auth application-default login
# On Cloud Run: default SA needs roles/aiplatform.user + roles/secretmanager.secretAccessor

# --- Arize Phoenix (self-hosted on Cloud Run) ---
# For self-hosted, both PHOENIX_API_KEY and PHOENIX_COLLECTOR_ENDPOINT point to your own instance.
PHOENIX_COLLECTOR_ENDPOINT=https://phoenix.your-domain.com
PHOENIX_API_KEY=px_live_

# --- Demo passcode (prevents random crawlers; surfaced in Devpost description) ---
# Fails closed: `/review*` returns 503 if unset, regardless of environment.
DEMO_PASSCODE=

# --- OIDC for /reflect (SECURITY-CRITICAL) ---
# Expected `aud` claim on the Google-signed ID token Cloud Scheduler
# presents to /reflect. Empty value means OIDC verification is SKIPPED —
# acceptable on localhost (server is unreachable from the internet),
# but a vulnerability on Cloud Run. The server detects Cloud Run via
# the auto-set `K_SERVICE` env var:
#   - K_SERVICE set + audience empty → lifespan logs ERROR and every
#     /reflect call returns 503 "server misconfigured (no OIDC audience)"
#   - K_SERVICE unset (localhost) + audience empty → audience check
#     skipped (Cloud Run IAM would still gate in prod).
# Set this to the public URL of your Cloud Run service.
REFLECT_OIDC_AUDIENCE=

# --- SEC EDGAR (contact required by SEC per fair-use rules) ---
SEC_EDGAR_USER_AGENT=hugo.majerczyk@proton.me

# ============================================================
# OPTIONAL — sensible defaults; override only if needed
# ============================================================

# --- Phoenix tracing (project + tracer-isolation toggle) ---
PHOENIX_PROJECT=ma-gatekeeper
# Set =1 to skip the `set_global_tracer_provider=False` kwarg if your
# environment requires Phoenix to be THE global tracer provider. Default
# is to isolate so we don't collide with other libraries' tracers.
PHOENIX_NO_ISOLATE=0

# --- Phoenix MCP (used by the Reflector) ---
PHOENIX_MCP_BASE_URL=https://phoenix.your-domain.com
PHOENIX_MCP_API_KEY=

# --- CORS allowlist (security — comma-separated; never "*") ---
# Default covers the Next.js dev server. Production: set to your
# deployed frontend origin(s).
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Upload + Files API tuning ---
# Hard cap on /review PDF uploads (DoS protection). 50 MiB default.
MAX_UPLOAD_BYTES=52428800
# Inline `Part.from_bytes` below this size; switch to Gemini Files API
# above it (avoids inline-PDF truncation past ~20 pages). 8 MiB default.
FILES_API_THRESHOLD_BYTES=8388608
# TTL for cached Files-API URIs (seconds). Google expires server-side
# at 48 h; we evict at 36 h to stay well clear of the boundary plus
# clock skew. Lower this if you observe expired-URI errors before 36 h.
FILES_API_URI_TTL_SECONDS=129600
# Hard cap on the URI cache + per-sha lock dict to bound memory on
# long-lived Cloud Run instances. Without this cap, the lock dict
# would grow linearly with all-time unique uploads (R4-1 finding).
# 64 covers the 5-deal demo + nightly Reflector + ad-hoc /review with
# comfortable buffer; raise if you have a heavier workload.
FILES_API_CACHE_MAX_ENTRIES=64

# --- MCP shutdown tuning ---
# Per-toolset hard timeout (seconds) for MCPToolset.aclose() during
# the FastAPI lifespan shutdown drain. Cloud Run gives 10 s between
# SIGTERM and SIGKILL; we want headroom so a single hung npx stdio
# child doesn't exceed the graceful-shutdown window.
MCP_ACLOSE_TIMEOUT_SECONDS=5.0

# --- Model override (evaluators + reflector) ---
GEMINI_MODEL=gemini-3-pro-preview

# --- Calibration artifact ---
THRESHOLDS_JSON=thresholds.json

# --- Allow-list lifespan validation ---
# On Cloud Run, set =1 so the lifespan probes each curated CIK at boot
# and surfaces unreachable ones via a per-deal 503 (instead of silent
# failure inside _fetch_filing_pdf at request time). Off (=0) in dev
# so the test suite stays offline.
VALIDATE_ALLOW_LIST_ON_BOOT=0
