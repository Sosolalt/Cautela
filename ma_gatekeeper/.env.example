# Copy to `.env` and fill in. Cloud Run pulls these from Secret Manager.
#
# Sections below are split between REQUIRED-on-Cloud-Run (security or
# functionality breaks without them) and OPTIONAL (safe defaults).
# `tests/test_env_documented.py` asserts every `os.environ.get(KEY)`
# call in `agent/` has a corresponding key in this file.

# ============================================================
# REQUIRED for any non-localhost (Cloud Run) deploy
# ============================================================

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# In dev: gcloud auth application-default login
# On Cloud Run: default SA needs roles/aiplatform.user + roles/secretmanager.secretAccessor

# --- Arize Phoenix (self-hosted on Cloud Run) ---
# For self-hosted, both PHOENIX_API_KEY and PHOENIX_COLLECTOR_ENDPOINT point to your own instance.
PHOENIX_COLLECTOR_ENDPOINT=https://phoenix.your-domain.com
PHOENIX_API_KEY=px_live_

# --- Demo passcode (prevents random crawlers; surfaced in Devpost description) ---
# Fails closed: `/review*` returns 503 if unset, regardless of environment.
DEMO_PASSCODE=

# --- OIDC for /reflect (SECURITY-CRITICAL) ---
# Expected `aud` claim on the Google-signed ID token Cloud Scheduler
# presents to /reflect. Empty value means OIDC verification is SKIPPED —
# acceptable on localhost (server is unreachable from the internet),
# but a vulnerability on Cloud Run. The server detects Cloud Run via
# the auto-set `K_SERVICE` env var:
#   - K_SERVICE set + audience empty → lifespan logs ERROR and every
#     /reflect call returns 503 "server misconfigured (no OIDC audience)"
#   - K_SERVICE unset (localhost) + audience empty → audience check
#     skipped (Cloud Run IAM would still gate in prod).
# Set this to the public URL of your Cloud Run service.
REFLECT_OIDC_AUDIENCE=

# --- SEC EDGAR (contact required by SEC per fair-use rules) ---
SEC_EDGAR_USER_AGENT=superseth775@gmail.com

# ============================================================
# OPTIONAL — sensible defaults; override only if needed
# ============================================================

# --- Phoenix tracing (project + tracer-isolation toggle) ---
PHOENIX_PROJECT=ma-gatekeeper
# Set =1 to skip the `set_global_tracer_provider=False` kwarg if your
# environment requires Phoenix to be THE global tracer provider. Default
# is to isolate so we don't collide with other libraries' tracers.
PHOENIX_NO_ISOLATE=0

# --- Phoenix MCP (used by the Reflector) ---
PHOENIX_MCP_BASE_URL=https://phoenix.your-domain.com
PHOENIX_MCP_API_KEY=

# --- CORS allowlist (security — comma-separated; never "*") ---
# Default covers the Next.js dev server. Production: set to your
# deployed frontend origin(s).
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Upload + Files API tuning ---
# Hard cap on /review PDF uploads (DoS protection). 50 MiB default.
MAX_UPLOAD_BYTES=52428800
# Inline `Part.from_bytes` below this size; switch to Gemini Files API
# above it (avoids inline-PDF truncation past ~20 pages). 8 MiB default.
FILES_API_THRESHOLD_BYTES=8388608
# TTL for cached Files-API URIs (seconds). Google expires server-side
# at 48 h; we evict at 36 h to stay well clear of the boundary plus
# clock skew. Lower this if you observe expired-URI errors before 36 h.
FILES_API_URI_TTL_SECONDS=129600
# Hard cap on the URI cache + per-sha lock dict to bound memory on
# long-lived Cloud Run instances. Without this cap, the lock dict
# would grow linearly with all-time unique uploads (R4-1 finding).
# 64 covers the 5-deal demo + nightly Reflector + ad-hoc /review with
# comfortable buffer; raise if you have a heavier workload.
FILES_API_CACHE_MAX_ENTRIES=64

# --- MCP shutdown tuning ---
# Per-toolset hard timeout (seconds) for MCPToolset.aclose() during
# the FastAPI lifespan shutdown drain. Cloud Run gives 10 s between
# SIGTERM and SIGKILL; we want headroom so a single hung npx stdio
# child doesn't exceed the graceful-shutdown window.
MCP_ACLOSE_TIMEOUT_SECONDS=5.0

# --- Model override (evaluators + reflector) ---
GEMINI_MODEL=gemini-3-pro-preview

# --- Calibration artifact ---
THRESHOLDS_JSON=thresholds.json

# --- Allow-list lifespan validation ---
# On Cloud Run, set =1 so the lifespan probes each curated CIK at boot
# and surfaces unreachable ones via a per-deal 503 (instead of silent
# failure inside _fetch_filing_pdf at request time). Off (=0) in dev
# so the test suite stays offline.
VALIDATE_ALLOW_LIST_ON_BOOT=0

# Fix 7 — Portfolio Analyst live vs mock toggle.
# =0 (default): /portfolio endpoint returns the canonical mock fixture
# at tests/fixtures/portfolio_expected_output.json (deterministic,
# CI-safe, no Vertex quota burn). =1: invokes make_live_portfolio()
# which raises NotImplementedError until the operator wires the ADK
# Runner against Vertex Files API. Flip to =1 on D9 once the live
# wrapper lands and Gemini 3 Pro quota is confirmed.
PORTFOLIO_LIVE=0

# §11 Build #3 — Reflector LoopAgent auto-PR toggle.
# =0 (default + tests + demo recording): when the LoopAgent body's
# should_promote gate fires, _stage_auto_pr returns (None, diff_text)
# and the auto_promoted SSE event carries staged_diff so the demo can
# show the "would-PR" path without invoking `gh`. =1: a real
# `gh pr create --title ... --body ...` subprocess runs with a 5s
# timeout (see reflector_loop._stage_auto_pr). Keep =0 during the
# locked-recording window; flip to =1 only after the post-POC pilot
# is wired and `gh` auth is provisioned in the runtime.
REFLECTOR_LOOP_AUTO_PR=0

# §11 Build #3 — Reflector LoopAgent iteration cap.
# Max number of recursive LoopAgent passes before the loop terminates
# (read in reflector_loop.py:83, default "3"). Keep =3 for tests + the
# demo recording; raise only if a deeper self-improvement loop is wanted.
REFLECTOR_LOOP_MAX_ITERATIONS=3

# §11 Build #3 — Reflector LoopAgent real-ADK toggle.
# =0 (default + tests + demo): the LoopAgent body runs against the
# deterministic mock harness — zero Vertex quota, reproducible. =1:
# invokes the real ADK Runner against Vertex (reflector_loop.py:523);
# raises until the operator wires it (post-hackathon work). Keep =0
# during the locked-recording window.
REFLECTOR_LOOP_USE_REAL_ADK=0

# --- Live eval throttling / 429-backoff knobs (scripts/_live_agent.py) ---
# Max retries on rate-limit (429) before giving up.
EVAL_MAX_RETRIES=6
# Base seconds for exponential backoff between retries.
EVAL_RETRY_BASE_SEC=10
# Cap (seconds) on a single backoff sleep.
EVAL_RETRY_CAP_SEC=120
# Fixed pacing delay (seconds) after each successful call to stay under TPM quota.
EVAL_REQUEST_DELAY_SEC=0

# --- Model-tier split (review pipeline runs on Flash; agents.py) ---
# GA model for the per-contract review fan-out (parser/classifier/judge).
# The heavy GEMINI_MODEL (Pro preview) is reserved for the Portfolio
# Analyst + Reflector; Flash carries the structured work an order of
# magnitude cheaper at the accuracy the eval rail demands.
GEMINI_FLASH_MODEL=gemini-3.5-flash
# Minimum seconds between consecutive Vertex model-call starts (global
# pacing valve under preview quota). 0 disables throttling; set 5-7 if
# the preview tier 429s under the classifier burst.
GEMINI_MIN_CALL_INTERVAL_SEC=0

# --- Reflector trace-scan + scoring tuning (reflector.py) ---
# Lookback window (hours) for the escalation-trace scan. 720 = 30 days.
REFLECTOR_LOOP_LOOKBACK_HOURS=720
# Phoenix client timeout (seconds) for the span/annotation queries; the
# 5s default ReadTimeouts against a cold maxScale=1 Cloud Run Phoenix.
REFLECTOR_PHOENIX_TIMEOUT_SECONDS=45
# Max spans pulled per scan (span_id-only projection keeps payload tiny
# so a memory-bound Phoenix doesn't 500 on full-attribute serialization).
REFLECTOR_SPAN_SCAN_LIMIT=2000
# Which candidate-vs-production metric the score gate compares.
REFLECTOR_SCORE_METRIC=coverage
# =1 opts back into the npx @arizeai/phoenix-mcp stdio server (needs a
# node runtime). Default 0 uses the node-free _DirectPhoenixToolset.
REFLECTOR_USE_NPX_MCP=0

# --- Self-improve confirm script (scripts/confirm_selfimprove_promotes.py) ---
# Required margin the paired-bootstrap CI lower bound must clear for the
# confirm script to call the promotion REAL (not a borderline pass).
CONFIRM_CI_LB_MARGIN=0.02
