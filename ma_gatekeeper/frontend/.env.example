# Base URL of the FastAPI service (agent/server.py).
NEXT_PUBLIC_API_BASE=http://localhost:8080

# Demo passcode (header X-Demo-Passcode). Public-grade; the security-
# sensitive route /reflect is OIDC-protected server-side.
NEXT_PUBLIC_DEMO_PASSCODE=

# Self-hosted Phoenix base URL + project for the trace iframe.
NEXT_PUBLIC_PHOENIX_URL=
NEXT_PUBLIC_PHOENIX_PROJECT=ma-gatekeeper
# Override the trace deep-link template if your Phoenix release uses
# a different URL shape. Tokens: {base}, {project}, {traceId}.
# Example for recent Phoenix builds:
#   NEXT_PUBLIC_PHOENIX_TRACE_URL={base}/projects/{project}/spans?traceId={traceId}
NEXT_PUBLIC_PHOENIX_TRACE_URL=
